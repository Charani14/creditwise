PORT=5001
CLIENT_URL=http://localhost:5173
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=creditwise_db

# Use a long, random value and keep backend/.env private.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d

# Optional: if both are set, the API creates this admin once at startup.
ADMIN_NAME=CreditWise Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_private_admin_password
